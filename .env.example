# Eigene Einstellungen für Abendkasse.
# update.sh legt daraus beim ersten Mal .env an – .env wird von Git und Updates nie überschrieben.
# Kommentare immer in eine eigene Zeile schreiben.

# Port auf dem Server (http://<server>:8020)
HOST_PORT=8020
# Externe Adresse für Einladungslinks, z. B. https://quiz.deinedomain.de
PUBLIC_URL=

# Auszahlung um diese Stunde (20 = 20:00 Uhr)
PAYOUT_HOUR=20
# Ab dieser Stunde sind die Tagesfragen offen
OPEN_HOUR=0
# Länge einer Spielwoche in Tagen
WEEK_DAYS=7
# Fragen pro Tag (Standard für neue Spiele)
QUESTIONS_PER_DAY=10
# 50:50-Joker pro Spieler und Runde
JOKERS_PER_DAY=1

# Push „Neue Tagesrunde“ ab dieser Stunde
MORNING_HOUR=6
# Extrarunde wird angeboten, wenn alle vor dieser Stunde fertig sind
EXTRA_BEFORE_HOUR=15
# Fragen in der Extrarunde
EXTRA_QUESTIONS=5
# Einsatz pro Frage: 0 bis MAX_STAKE in Schritten von STAKE_STEP
MAX_STAKE=30
STAKE_STEP=10
# Tempo-Bonus: richtig innerhalb von TEMPO_SECONDS Sekunden
TEMPO_SECONDS=10
TEMPO_BONUS=2
# Punkte für die beste Schätzung bei der Duell-Frage
DUEL_POINTS=20
# Erinnerungs-Push, falls noch nicht gespielt
REMINDER_HOUR=18

# Nächtliche Sicherung: Zielordner auf dem Server (z. B. eingebundene Synology-Freigabe)
BACKUP_PATH=./backups/auto
# Uhrzeit der Sicherung und Anzahl der aufbewahrten Tage
BACKUP_HOUR=3
BACKUP_KEEP=14

# Geheimes Token für den Updater (Update aus der App). Wird von update.sh automatisch erzeugt.
UPDATE_TOKEN=

# Absender für Push (mailto: oder https-Adresse)
VAPID_SUBJECT=mailto:abendkasse@example.com

POINTS_PER_CORRECT=10
PERFECT_DAY_BONUS=20
WEEK_WIN_BONUS=100
MAX_PLAYERS=2

# Setzen, um /api/admin/* zu nutzen
ADMIN_TOKEN=
# Optional: Webhook bei Auszahlung/Wochenende (z. B. Home Assistant)
WEBHOOK_URL=
