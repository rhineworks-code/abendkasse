# Eigene Einstellungen für Abendkasse.
# update.sh legt daraus beim ersten Mal .env an – .env wird von Git und Updates nie überschrieben.
# Kommentare immer in eine eigene Zeile schreiben.

# Port auf dem Server (http://<server>:8020)
HOST_PORT=8020
# Externe Adresse für Einladungslinks, z. B. https://quiz.deinedomain.de
PUBLIC_URL=

# Auszahlung um diese Stunde (20 = 20:00 Uhr)
PAYOUT_HOUR=20
# Ab dieser Stunde sind die Tagesfragen offen
OPEN_HOUR=0
# Länge einer Spielwoche in Tagen
WEEK_DAYS=7
# Fragen pro Tag (Standard für neue Spiele)
QUESTIONS_PER_DAY=10
# 50:50-Joker pro Spieler und Tag
JOKERS_PER_DAY=1

POINTS_PER_CORRECT=10
PERFECT_DAY_BONUS=20
WEEK_WIN_BONUS=100
MAX_PLAYERS=2

# Setzen, um /api/admin/* zu nutzen
ADMIN_TOKEN=
# Optional: Webhook bei Auszahlung/Wochenende (z. B. Home Assistant)
WEBHOOK_URL=
